@using MyAiFeedbackSystem.WebApp.Client.Components.AdminReviews
@page "/admin/reviews"

<PageTitle>Керування відгуками</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Керування відгуками</MudText>
<MudButton OnClick="LogoutAsync" Class="mb-4">Вийти</MudButton>
<MudAlert Severity="Severity.Info" Class="mb-4">
    Локальна панель менеджера. AI-чернетки потребують перевірки перед використанням.
</MudAlert>

@if (!_ready)
{
    <MudText>Відновлення стану панелі…</MudText>
    <MudProgressLinear Indeterminate="true" Class="mt-2" />
}
else
{
    @if (_storageError)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4">
            Сховище вкладки недоступне. Фільтри й чернетка не відновляться після оновлення.
        </MudAlert>
    }

    <AdminReviewFilters State="_state" SearchChanged="SaveStateAsync"
                        SentimentChanged="OnSentimentChanged" PriorityChanged="OnPriorityChanged" />

    <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="LoadReviewsAsync"
               Disabled="_loading" Class="mb-4">Оновити список</MudButton>

    @if (_loadError)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">
            Не вдалося завантажити відгуки. Перевірте з’єднання й оновіть список.
        </MudAlert>
    }
    else if (!_loading && _reviews.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Class="mb-4">Відгуків поки немає.</MudAlert>
    }

    <AdminReviewTable Items="FilteredReviews" Loading="_loading" ReviewSelected="SelectReviewAsync" />

    @if (SelectedReview is { } selected)
    {
        <AdminReviewDetails @key="selected.Id" Review="selected" Draft="_draft"
                            IsAnalyzing="_analyzingIds.Contains(selected.Id)"
                            IsGenerating="_generatingIds.Contains(selected.Id)"
                            Analyze="AnalyzeAsync" GenerateDraft="GenerateDraftAsync"
                            DraftChanged="SaveDraftAsync" />
    }
}
